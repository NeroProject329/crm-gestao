{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm turbo run build --filter=@crm/web...",
    "watchPatterns": [
      "apps/web/**",
      "packages/**",
      "tooling/**",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "turbo.json",
      "railway/web.json"
    ]
  },
  "deploy": {
    "startCommand": "pnpm --filter @crm/web exec next start -H 0.0.0.0 -p $PORT",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ALWAYS"
  }
}