{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm turbo run build --filter=@crm/api...",
    "watchPatterns": [
      "apps/api/**",
      "packages/**",
      "tooling/**",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "turbo.json",
      "railway/api.json"
    ]
  },
  "deploy": {
    "preDeployCommand": [
      "pnpm --filter @crm/database db:migrate:deploy"
    ],
    "startCommand": "pnpm --filter @crm/api start:prod",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ALWAYS"
  }
}