{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm turbo run build --filter=@crm/worker...",
    "watchPatterns": [
      "apps/worker/**",
      "packages/**",
      "tooling/**",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "turbo.json",
      "railway/worker.json"
    ]
  },
  "deploy": {
    "startCommand": "pnpm --filter @crm/worker start:prod",
    "restartPolicyType": "ALWAYS"
  }
}