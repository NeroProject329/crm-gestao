# =========================================================
# CRM GESTAO COMERCIAL E CONTABILIDADE
# Environment template
# NUNCA coloque credenciais reais neste arquivo.
# =========================================================

# ---------------------------------------------------------
# Application
# ---------------------------------------------------------

NODE_ENV=development
APP_ENV=development
APP_TIMEZONE=America/Sao_Paulo

# ---------------------------------------------------------
# Web
# ---------------------------------------------------------

NEXT_PUBLIC_API_URL=http://localhost:3001

# ---------------------------------------------------------
# API
# ---------------------------------------------------------

PORT=3001

# ---------------------------------------------------------
# Railway PostgreSQL
# Preencher com a URL real do ambiente correspondente.
# ---------------------------------------------------------

DATABASE_URL=

# ---------------------------------------------------------
# Railway Redis
# Preencher com a URL real do ambiente correspondente.
# ---------------------------------------------------------

REDIS_URL=

# ---------------------------------------------------------
# Cloudflare R2
# ---------------------------------------------------------

R2_ENDPOINT=
R2_REGION=auto
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ---------------------------------------------------------
# Pushcut
# ---------------------------------------------------------

PUSHCUT_BASE_URL=https://api.pushcut.io/v1
PUSHCUT_API_KEY=

# ---------------------------------------------------------
# Authentication
# Reservado para a etapa de Auth/RBAC.
# Ainda nao utilizado.
# ---------------------------------------------------------

JWT_ACCESS_SECRET=
SESSION_SECRET=

# ---------------------------------------------------------
# Initial database seed
# ---------------------------------------------------------

SEED_COMPANY_NAME=CRM Gestao Comercial e Contabilidade
SEED_COMPANY_SLUG=crm-gestao

SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

SEED_WEEK_START_DAY=1

# Optional initial bank fee policy.
# Configure both or leave both empty.
SEED_BANK_FEE_BPS=
SEED_BANK_FEE_EFFECTIVE_FROM=


# Authentication
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_DAYS=30
AUTH_COOKIE_SAME_SITE=lax

WEB_ORIGIN=http://localhost:3000


# Cloudflare R2
R2_ENDPOINT=https://958c88aaa46cfb9fe462ff4e57f7d850.r2.cloudflarestorage.com
R2_REGION=auto
R2_BUCKET_NAME=crm-gestao-receipts-development
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

R2_UPLOAD_TOKEN_SECRET=
R2_UPLOAD_URL_TTL_SECONDS=600
R2_DOWNLOAD_URL_TTL_SECONDS=300
R2_MAX_RECEIPT_BYTES=10485760


WORKER_OUTBOX_POLL_MS=1000
WORKER_OUTBOX_BATCH_SIZE=50
WORKER_OUTBOX_MAX_ATTEMPTS=10
WORKER_OUTBOX_BACKOFF_MS=2000
WORKER_OUTBOX_LEASE_SECONDS=1800

WORKER_JOB_ATTEMPTS=5
WORKER_JOB_BACKOFF_MS=2000

WORKER_DOMAIN_CONCURRENCY=4
WORKER_PUSH_CONCURRENCY=4
WORKER_MAINTENANCE_CONCURRENCY=1

WORKER_RECALC_MAX_WAIT_MS=30000
WORKER_RECALC_TIMEOUT_MS=300000

WORKER_SCHEDULER_SYNC_MS=60000
WORKER_ENSURE_DAILY_INTERVAL_MS=60000
WORKER_PUSH_RECOVERY_INTERVAL_MS=60000

PUSH_MAX_ATTEMPTS=5
PUSH_BACKOFF_BASE_MS=5000
PUSH_HTTP_TIMEOUT_MS=10000